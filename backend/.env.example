ENVIRONMENT=dev

# CORS origin for the React frontend (use the dev server URL locally)
CORS_ORIGIN=http://localhost:5173

# Rate limiting thresholds (per IP, window in seconds)
IGNORE_CLIENTS_AFTER=5
BLACKLIST_CLIENTS_AFTER=20
FORGIVE_CLIENTS_AFTER=3600

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Admin auth - any non-empty secret string; the frontend pastes it on the login screen
ADMIN_TOKEN=change-me

# SMTP - leave MAIL_ENABLED=false unless you have working credentials
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
