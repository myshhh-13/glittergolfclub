# Copy this file to backend/.env before running docker compose up
# (docker-compose.yml passes the file through `env_file`)

ENVIRONMENT=prod

# Origin used for CORS - the nginx URL the SPA is served on
CORS_ORIGIN=http://localhost:8080

# Rate limiting thresholds (per IP, FORGIVE_CLIENTS_AFTER is in seconds)
IGNORE_CLIENTS_AFTER=5
BLACKLIST_CLIENTS_AFTER=20
FORGIVE_CLIENTS_AFTER=3600

# Redis - leave host as "redis" inside docker compose
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Admin auth - any opaque string; paste it on /admin/login
ADMIN_TOKEN=change-me-to-a-long-random-string

# Email - disabled by default
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
